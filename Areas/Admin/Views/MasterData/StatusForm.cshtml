@model StudentStatusInput
@{ ViewData["Title"] = Model.Id is null ? "เพิ่มสถานะนักเรียน" : "แก้ไขสถานะนักเรียน"; }
<form asp-action="StatusForm" method="post" class="surface form-card form-narrow">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id">
    <div class="mb-3"><label asp-for="Name" class="form-label required"></label><input asp-for="Name" class="form-control"><span asp-validation-for="Name" class="invalid-text"></span></div>
    <div class="mb-3"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" class="form-control"><span asp-validation-for="SortOrder" class="invalid-text"></span></div>
    <div class="form-check mb-3">
        <input asp-for="IsEnrolled" class="form-check-input" disabled="@Model.IsSystem">
        <label asp-for="IsEnrolled" class="form-check-label"></label>
        @if (Model.IsSystem) { <div class="form-text">สถานะของระบบ ไม่สามารถเปลี่ยนค่านี้ได้</div> }
    </div>
    <div class="form-actions"><a asp-action="Index" asp-route-tab="statuses" class="btn btn-soft">กลับ</a><button type="submit" class="btn btn-primary">บันทึก</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
