@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!doctype html>
<html lang="th">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · College Activity Calendar</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23b9552f'/><path d='M8 12h16M11 7v4M21 7v4M8 10h16v14H8z' stroke='white' stroke-width='2' fill='none'/></svg>">
    <partial name="_Styles" />
</head>
<body class="auth-body">
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
