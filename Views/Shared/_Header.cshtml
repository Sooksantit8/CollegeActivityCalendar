<header class="app-header">
    <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="เปิดเมนู">
        <i class="bi bi-list"></i>
    </button>
    <div class="page-heading min-w-0">
        <p class="eyebrow">College Activity Calendar</p>
        <h1 class="text-truncate">@ViewData["Title"]</h1>
        @if (ViewData["Subtitle"] is string subtitle)
        {
            <p class="page-subtitle">@subtitle</p>
        }
    </div>
    <div class="dropdown ms-auto">
        <button class="user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="user-avatar"><i class="bi bi-person"></i></span>
            <span class="user-text d-none d-sm-block">
                <strong>@User.GetFullName()</strong>
                <small>@DisplayText.Role(User.GetPrimaryRole())</small>
            </span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle me-2"></i>ข้อมูลส่วนตัว</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2"></i>ออกจากระบบ</button>
                </form>
            </li>
        </ul>
    </div>
</header>
