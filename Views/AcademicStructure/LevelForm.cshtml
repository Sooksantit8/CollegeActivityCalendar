@model EducationLevelInput
@{ ViewData["Title"] = Model.Id is null ? "เพิ่มระดับการศึกษา" : "แก้ไขระดับการศึกษา"; }
<form asp-action="LevelForm" method="post" class="surface form-card form-narrow">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id">
    <div class="mb-3"><label asp-for="Code" class="form-label required"></label><input asp-for="Code" class="form-control"><span asp-validation-for="Code" class="invalid-text"></span></div>
    <div class="mb-3"><label asp-for="Name" class="form-label required"></label><input asp-for="Name" class="form-control"><span asp-validation-for="Name" class="invalid-text"></span></div>
    <div class="mb-3"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" class="form-control"><span asp-validation-for="SortOrder" class="invalid-text"></span></div>
    <div class="form-actions"><a asp-action="Index" asp-route-tab="levels" class="btn btn-soft">กลับ</a><button type="submit" class="btn btn-primary">บันทึก</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
