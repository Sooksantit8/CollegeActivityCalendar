@model SemesterFormViewModel
@{ ViewData["Title"] = Model.Input.Id is null ? "เพิ่มภาคเรียน" : "แก้ไขภาคเรียน"; }
<form asp-action="SemesterForm" method="post" class="surface form-card form-narrow">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Input.Id">
    <div class="mb-3">
        <label asp-for="Input.AcademicYearId" class="form-label required"></label>
        <select asp-for="Input.AcademicYearId" asp-items="Model.AcademicYears" class="form-select"><option value="">เลือกปีการศึกษา</option></select>
        <span asp-validation-for="Input.AcademicYearId" class="invalid-text"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Number" class="form-label required"></label>
        <input asp-for="Input.Number" class="form-control">
        <span asp-validation-for="Input.Number" class="invalid-text"></span>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-6"><label asp-for="Input.StartDate" class="form-label required"></label><input asp-for="Input.StartDate" class="form-control"><span asp-validation-for="Input.StartDate" class="invalid-text"></span></div>
        <div class="col-6"><label asp-for="Input.EndDate" class="form-label required"></label><input asp-for="Input.EndDate" class="form-control"><span asp-validation-for="Input.EndDate" class="invalid-text"></span></div>
    </div>
    <div class="form-actions"><a asp-action="Index" asp-route-tab="semesters" class="btn btn-soft">กลับ</a><button type="submit" class="btn btn-primary">บันทึก</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
