@model (string Title, string Unit, List<ReportBar> Rows)
@using Microsoft.AspNetCore.Routing
@{ var max = Model.Rows.Count == 0 ? 1 : Math.Max(1, Model.Rows.Max(r => r.Count)); }
<section class="surface p-3 p-md-4 h-100">
    <h2 class="section-title">@Model.Title</h2>
    @if (Model.Rows.Count == 0)
    {
        <p class="text-muted-soft mb-0">ไม่มีข้อมูลในช่วงนี้</p>
    }
    else
    {
        <ul class="bar-list">
            @foreach (var row in Model.Rows)
            {
                var width = (row.Count * 100.0 / max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                <li title="@row.Label: @row.Count.ToString("N0") @Model.Unit">
                    @if (row.LinkValues is not null)
                    {
                        var route = new RouteValueDictionary(row.LinkValues);
                        <a class="bar-link" href="@Url.Action("Index", "Events", route)" data-stat-list="@Url.Action("List", "Events", route)"
                           data-stat-title="@Model.Title: @row.Label" data-stat-key="@row.Key" aria-expanded="false" aria-controls="statPanel">
                            <div class="bar-head"><span>@row.Label</span><strong>@row.Count.ToString("N0") <i class="bi bi-chevron-down stat-arrow"></i></strong></div>
                            <div class="bar-track"><div class="bar-fill" style="width:@width%"></div></div>
                        </a>
                    }
                    else
                    {
                        <div class="bar-head"><span>@row.Label</span><strong>@row.Count.ToString("N0")</strong></div>
                        <div class="bar-track"><div class="bar-fill" style="width:@width%"></div></div>
                    }
                </li>
            }
        </ul>
    }
</section>
