@model ReportViewModel
@{
    ViewData["Title"] = "รายงาน";
    ViewData["Subtitle"] = "สรุปกิจกรรมและนักเรียนตามช่วงเวลา";
    var exportUrl = Url.Action("ExportCsv", new { from = Model.From.ToString("yyyy-MM-dd"), to = Model.To.ToString("yyyy-MM-dd"), departmentId = Model.DepartmentId });
}
<form method="get" asp-action="Index" class="surface p-3 p-md-4 mb-3 row g-2 align-items-end mx-0">
    <div class="col-6 col-md-3"><label class="form-label" for="from">ตั้งแต่วันที่</label><input id="from" name="from" type="date" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")"></div>
    <div class="col-6 col-md-3"><label class="form-label" for="to">ถึงวันที่</label><input id="to" name="to" type="date" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")"></div>
    <div class="col-12 col-md-3">
        <label class="form-label" for="departmentId">แผนก</label>
        <select id="departmentId" name="departmentId" class="form-select">
            <option value="">ทุกแผนก</option>
            @foreach (var d in Model.Departments) { <option value="@d.Value" selected="@(d.Value == Model.DepartmentId?.ToString())">@d.Text</option> }
        </select>
    </div>
    <div class="col-12 col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">ดูรายงาน</button>
        <a href="@exportUrl" class="btn btn-soft"><i class="bi bi-download me-1"></i>CSV</a>
    </div>
</form>
<div class="stat-grid">
    @foreach (var stat in Model.Stats) { <partial name="_StatCard" model="stat" /> }
</div>
<div class="row g-3 mb-3">
    <div class="col-lg-6">@await Html.PartialAsync("_Bars", ("กิจกรรมตามเดือน", "กิจกรรม", Model.ByMonth))</div>
    <div class="col-lg-6">@await Html.PartialAsync("_Bars", ("กิจกรรมตามประเภท", "กิจกรรม", Model.ByCategory))</div>
    <div class="col-lg-6">@await Html.PartialAsync("_Bars", ("กิจกรรมตามระดับกลุ่มเป้าหมาย", "กิจกรรม", Model.ByLevel))</div>
    <div class="col-lg-6">@await Html.PartialAsync("_Bars", ("กิจกรรมตามสถานะ", "กิจกรรม", Model.ByStatus))</div>
    <div class="col-lg-6">@await Html.PartialAsync("_Bars", ("กิจกรรมที่กำหนดเป้าหมายรายแผนก", "กิจกรรม", Model.ByDepartment))</div>
    <div class="col-lg-6">@await Html.PartialAsync("_Bars", ("นักเรียนที่ยังศึกษาอยู่ตามแผนก", "คน", Model.StudentsByDepartment))</div>
</div>
<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="section-title mb-0">การเลื่อนชั้นล่าสุด</h2>
    <a asp-controller="StudentPromotion" asp-action="History" class="link-accent">ดูทั้งหมด</a>
</div>
@if (Model.RecentPromotions.Count == 0)
{
    <div class="surface empty-state"><p>ยังไม่มีการเลื่อนชั้น</p></div>
}
else
{
    <div class="surface table-card">
        <table class="table table-stack align-middle mb-0">
            <thead><tr><th>วันที่</th><th>รอบ</th><th>จำนวน</th><th>ผู้ดำเนินการ</th></tr></thead>
            <tbody>
                @foreach (var h in Model.RecentPromotions)
                {
                    <tr><td data-label="วันที่">@h.ExecutedAtText</td><td data-label="รอบ">@h.FromYear → @h.ToYear</td><td data-label="จำนวน">@h.Total คน</td><td data-label="ผู้ดำเนินการ">@h.ExecutedBy</td></tr>
                }
            </tbody>
        </table>
    </div>
}
